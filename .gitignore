__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.vox-cache/
build/
dist/

# The film is a project, not part of the package. Its plans and its code belong
# in git; its generated megabytes do not.
film/build/
film/remotion/node_modules/
film/remotion/public/
film/remotion/out/
film/audio/*.wav

# Workspace memory, not part of the package. Skills are: they are instructions the
# package ships with, and a rule that lives only on one machine is not a rule.
.workbuddy-ai/*
!.workbuddy-ai/skills/
!.workbuddy-ai/skills/**
